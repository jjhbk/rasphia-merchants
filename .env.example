# Remote PostgreSQL connection string. Keep this server-side secret out of source control.
# Run migrations explicitly with: pnpm migrate
DATABASE_URL=postgresql://username:password@host:5432/rasphia?sslmode=require

# Server-side OpenAI evaluation for AI Readiness Score. Leave blank to use
# deterministic checks only. Pick any Responses API model available to your account.
OPENAI_API_KEY=
OPENAI_AI_READINESS_MODEL=gpt-5-mini

# Optional public-data enrichment for the Business Diagnosis. Enable Places API
# (New) in Google Cloud, restrict this server-side key, then add it here. This
# is not a browser Maps JavaScript key and must never be exposed to clients.
GOOGLE_PLACES_API_KEY=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Rasphia <hello@yourdomain.com>"

# Public Instagram-profile enrichment via Apify. Merchant accounts are never
# connected; the diagnosis uses public profile and latest-post data only.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-profile-scraper

# Generic public-web discovery. Used to find a business's related website,
# Instagram profile from any one supplied source.
BRAVE_SEARCH_API_KEY=

# Destination for “Schedule a call” buttons.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com

# Google OAuth for Rasphia sign-in. Set the authorized redirect URI in Google
# Cloud to: http://localhost:3000/api/auth/google/callback (local) and your
# production equivalent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A random 32+ character server-side secret used to sign OAuth state.
AUTH_SECRET=
