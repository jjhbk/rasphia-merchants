# Remote PostgreSQL connection string. Keep this server-side secret out of source control.
# Run migrations explicitly with: pnpm migrate
DATABASE_URL=postgresql://username:password@host:5432/rasphia?sslmode=require

# Server-side OpenAI evaluation for AI Readiness Score. Leave blank to use
# deterministic checks only. Pick any Responses API model available to your account.
OPENAI_API_KEY=
OPENAI_AI_READINESS_MODEL=gpt-5-mini

# Destination for “Schedule a call” buttons.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com

